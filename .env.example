# Copy this file to .env and fill in your real values.
# Never commit the .env file — it contains secrets.

# ── UiPath OAuth credentials ──────────────────────────────────────────────────
# Create a UiPath external application (OAuth client_credentials) in your tenant.
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=

# ── UiPath tenant / environment ───────────────────────────────────────────────
# org_name  : your UiPath organization name (appears in the URL after the base URL)
# tenant    : the tenant you want to target
# base_url  : https://cloud.uipath.com for production, or your staging URL
UIPATH_ORG_NAME=your-org-name
UIPATH_TENANT_NAME=your-tenant-name
UIPATH_BASE_URL=https://cloud.uipath.com

# ── IXP project ───────────────────────────────────────────────────────────────
# Exact name of the IXP project in your tenant (used to look up the project ID)
IXP_PROJECT_NAME=your-ixp-project-name

# ── Standalone script only ────────────────────────────────────────────────────
# Local path to the document you want to extract (used by uipath_ixp_extraction.py)
DOCUMENT_PATH=path/to/your/document.pdf
